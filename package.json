{
  "name": "cortico-world-netease-play",
  "version": "0.1.27",
  "type": "module",
  "description": "让大肥鱼帮你点歌，不用动鼠标键盘：说出歌名就搜、排到歌单最前连续播放。仅支持网易云音乐，仅限 Windows 系统。",
  "author": "ailing",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/begood7912/cortico-world-netease-play.git"
  },
  "homepage": "https://github.com/begood7912/cortico-world-netease-play#readme",
  "bugs": {
    "url": "https://github.com/begood7912/cortico-world-netease-play/issues"
  },
  "files": [
    "src/",
    "py/",
    "webui/",
    "describe.json",
    "CHANGELOG.md",
    "ENV_PROMPT.md",
    "README.md",
    "INSTALL.md",
    "PUBLISH.md"
  ],
  "keywords": [
    "coopanion",
    "cortico-world",
    "netease",
    "music",
    "tts",
    "网易云",
    "点歌"
  ],
  "os": [
    "win32"
  ],
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "网易云陪听",
    "describe": "describe.json",
    "webUiClient": "webui/panel.js",
    "webUiStyle": "webui/panel.css",
    "tags": [
      "companion",
      "voice",
      "local",
      "external-setup",
      "requires-key",
      "sensitive-data",
      "unofficial-api"
    ]
  }
