  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/begood7912/cortico-world-netease-play.git"
  },
  "homepage": "https://github.com/begood7912/cortico-world-netease-play#readme",
  "bugs": {
    "url": "https://github.com/begood7912/cortico-world-netease-play/issues"
  },
  "files": [
    "src/",
    "py/",
    "webui/",
    "describe.json",
    "ENV_PROMPT.md",
    "README.md",
    "INSTALL.md",
    "PUBLISH.md"
  ],
  "keywords": [
    "coopanion",
    "cortico-world",
    "netease",
